# ==============================================================================
# BOM / BOQ Studio Pro — Environment Variables
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Tailscale Authentication Key (optional but recommended for automated headless login)
# Generate a reusable/pre-authorized auth key from: https://login.tailscale.com/admin/settings/keys
# If left blank, you can authenticate interactively via link shown in `docker compose logs -f`
TS_AUTHKEY=

# Tailscale Hostname (default: bom)
TS_HOSTNAME=bom

# Tailscale Tailnet Domain (default: ratfish-regulus.ts.net)
TS_TAILNET=ratfish-regulus.ts.net

# Enable Tailscale Funnel for public HTTPS access (https://bom.ratfish-regulus.ts.net)
TS_FUNNEL=true

# Tailscale Extra Arguments (e.g., --advertise-tags=tag:server)
TS_EXTRA_ARGS=

# Application Secret Key (change to a random 64-char string for production)
SECRET_KEY=b0m-sUpEr-s3cr3t-kEy-998822-ph-engr-alex-2026

# Server Port
PORT=8000
