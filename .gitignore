# ---------------------------------------------------------------------------
# Runtime data (live database, user uploads, backups)
# These hold real documents, password hashes and the encrypted department
# API keys, so they must never be committed. Docker builds copy them from the
# local folder, not from git.
# ---------------------------------------------------------------------------
/bom_system.db
*.db-journal
*.db-wal
*.db-shm
/bom_db_dump.sql
/users.json
/user_activity_logs.json
/data/
/uploads/*
!/uploads/.htaccess

