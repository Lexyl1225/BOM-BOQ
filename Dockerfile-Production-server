# ==============================================================================
# BOM / BOQ Studio Pro — Docker Container with Integrated Tailscale
# Hostname: bom
# In the Production Server Delete the 'Dockerfile' and Rename this file as Dockerfile
# Note: The Original Dockerfile is for Development and Testing, this one is for Production Server
# ==============================================================================

FROM python:3.12-slim-bookworm

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    DATA_DIR=/app/data \
    TS_HOSTNAME=bom

# Install system dependencies, networking tools, and Tailscale
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    iptables \
    iproute2 \
    procps \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create application and persistence directories
WORKDIR /app
RUN mkdir -p /app/data /app/data/uploads /app/data/backups /var/lib/tailscale /var/run/tailscale /dev/net

# Install Python requirements
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code (runtime DB and uploads live strictly in the mounted /app/data volume)
COPY app/ /app/app/
COPY run.py /app/run.py
# API key generator (the app loads generate_api_key() from it)
COPY api-key-gen.py /app/api-key-gen.py
# Command-line tool to create or recover an Administrator account
COPY create-admin.py /app/create-admin.py

# Copy container entrypoint and normalize line endings (prevents Windows CRLF boot errors)
COPY entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Expose web application port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]